# Referência de TODAS as variáveis. Não coloque valores reais neste arquivo.
# Local: segredos em .dev.vars (veja .dev.vars.example). Staging/produção: `wrangler secret put NOME --env <ambiente>`.
#
# --- Segredos (wrangler secret) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
#
# --- Variáveis (wrangler.jsonc > vars) ---
ENVIRONMENT=local                # local | staging | production
TELEGRAM_MODE=mock               # mock (não chama o Telegram) | live
AI_ENABLED=false                 # true liga Workers AI (gera custo conforme uso)
AI_STT_MODEL=                    # ex.: @cf/openai/whisper-large-v3-turbo (conferido em 22/11/2026)
AI_EXTRACTION_MODEL=             # ex.: @cf/mistralai/mistral-small-3.1-24b-instruct
AI_VISION_MODEL=                 # opcional; deixe vazio para não analisar fotos
AI_DAILY_REQUEST_LIMIT=200       # teto operacional interno (NÃO limita a fatura)
AUDIO_MAX_SECONDS=300
AUDIO_MAX_BYTES=10485760
IMAGE_MAX_BYTES=10485760
MEDIA_RETENTION_DAYS=180
ACCESS_TEAM_DOMAIN=              # https://<time>.cloudflareaccess.com
ACCESS_AUD=                      # Application Audience (AUD) tag do Access
ADMIN_DEV_BYPASS_EMAIL=          # SÓ local/test: e-mail admin usado sem Access
DAILY_SUMMARY_HOUR=7             # hora local (America/Sao_Paulo) do resumo diário
