{
  "name": "@adripatina/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config ../../wrangler.jsonc",
    "build": "wrangler deploy --dry-run --outdir dist --config ../../wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config ../../wrangler.jsonc",
    "db:seed:local": "wrangler d1 execute DB --local --file ../../db/seeds/0001_demo_catalog.sql --config ../../wrangler.jsonc",
    "seed:generate": "tsx ../../scripts/generate-seed.ts",
    "demo": "tsx ../../scripts/demo-flow.ts"
  },
  "dependencies": {
    "@adripatina/conversations": "workspace:*",
    "@adripatina/domain": "workspace:*",
    "@adripatina/pdf": "workspace:*",
    "@adripatina/pricing": "workspace:*",
    "@adripatina/shared": "workspace:*",
    "hono": "^4.7.0",
    "jose": "^6.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "tsx": "^4.19.0",
    "wrangler": "^4.40.0"
  }
}
