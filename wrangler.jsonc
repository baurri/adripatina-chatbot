{
  // adripatina — configuração do Worker (API + webhook Telegram + painel estático + cron)
  // NENHUM recurso real é criado por este arquivo. IDs abaixo são placeholders:
  // substitua pelos IDs gerados por `wrangler d1 create` / `wrangler r2 bucket create`
  // somente após aprovação (ver README > Deploy manual).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adripatina-chatbot",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "apps/admin-web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/p/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adripatina",
      "database_id": "c761a787-503e-4f75-829b-e4b08692fdf4",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "adripatina-files" }],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://adripatina-chatbot.baurri.workers.dev",
    "AI_ENABLED": "true",
    "AI_STT_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "AI_EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    "AI_VISION_MODEL": "",
    "AI_DAILY_REQUEST_LIMIT": "3000",
    "AUDIO_MAX_SECONDS": "300",
    "AUDIO_MAX_BYTES": "10485760",
    "IMAGE_MAX_BYTES": "10485760",
    "MEDIA_RETENTION_DAYS": "180",
    "ACCESS_TEAM_DOMAIN": "https://baurri.cloudflareaccess.com",
    "ACCESS_AUD": "8adb41e4e2d0046d0825df4cf995eb26a5bda29de7d4ebba6fa21532f5749b7a",
    "ADMIN_DEV_BYPASS_EMAIL": "",
    "TELEGRAM_MODE": "live",
    "DAILY_SUMMARY_HOUR": "7",
    "PROACTIVE_MODE": "live"
  },
  "env": {
    "local": {
      "name": "adripatina-chatbot-local",
      "d1_databases": [
        { "binding": "DB", "database_name": "adripatina-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "db/migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "adripatina-files-local" }],
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "local",
        "AI_ENABLED": "false",
        "AI_STT_MODEL": "",
        "AI_EXTRACTION_MODEL": "",
        "AI_VISION_MODEL": "",
        "AI_DAILY_REQUEST_LIMIT": "3000",
        "AUDIO_MAX_SECONDS": "300",
        "AUDIO_MAX_BYTES": "10485760",
        "IMAGE_MAX_BYTES": "10485760",
        "MEDIA_RETENTION_DAYS": "180",
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "ADMIN_DEV_BYPASS_EMAIL": "admin@exemplo.local",
        "TELEGRAM_MODE": "mock",
        "DAILY_SUMMARY_HOUR": "7",
        "PROACTIVE_MODE": "dry_run"
      }
    },
    "staging": {
      "name": "adripatina-chatbot-staging",
      "d1_databases": [
        { "binding": "DB", "database_name": "adripatina-staging", "database_id": "REPLACE_WITH_STAGING_D1_ID", "migrations_dir": "db/migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "adripatina-files-staging" }],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "staging",
        "AI_ENABLED": "false",
        "AI_STT_MODEL": "@cf/openai/whisper-large-v3-turbo",
        "AI_EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "AI_VISION_MODEL": "",
        "AI_DAILY_REQUEST_LIMIT": "3000",
        "AUDIO_MAX_SECONDS": "300",
        "AUDIO_MAX_BYTES": "10485760",
        "IMAGE_MAX_BYTES": "10485760",
        "MEDIA_RETENTION_DAYS": "180",
        "ACCESS_TEAM_DOMAIN": "REPLACE_https://<time>.cloudflareaccess.com",
        "ACCESS_AUD": "REPLACE_WITH_ACCESS_AUD_TAG",
        "ADMIN_DEV_BYPASS_EMAIL": "",
        "TELEGRAM_MODE": "live",
        "DAILY_SUMMARY_HOUR": "7",
        "PROACTIVE_MODE": "dry_run"
      }
    },
    "production": {
      "name": "adripatina-chatbot",
      "d1_databases": [
        { "binding": "DB", "database_name": "adripatina", "database_id": "c761a787-503e-4f75-829b-e4b08692fdf4", "migrations_dir": "db/migrations" }
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "adripatina-files" }],
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["*/15 * * * *"] },
      "vars": {
        "ENVIRONMENT": "production",
    "PUBLIC_BASE_URL": "https://adripatina-chatbot.baurri.workers.dev",
        "AI_ENABLED": "true",
        "AI_STT_MODEL": "@cf/openai/whisper-large-v3-turbo",
        "AI_EXTRACTION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "AI_VISION_MODEL": "",
        "AI_DAILY_REQUEST_LIMIT": "3000",
        "AUDIO_MAX_SECONDS": "300",
        "AUDIO_MAX_BYTES": "10485760",
        "IMAGE_MAX_BYTES": "10485760",
        "MEDIA_RETENTION_DAYS": "180",
        "ACCESS_TEAM_DOMAIN": "https://baurri.cloudflareaccess.com",
        "ACCESS_AUD": "8adb41e4e2d0046d0825df4cf995eb26a5bda29de7d4ebba6fa21532f5749b7a",
        "ADMIN_DEV_BYPASS_EMAIL": "",
        "TELEGRAM_MODE": "live",
        "DAILY_SUMMARY_HOUR": "7",
        "PROACTIVE_MODE": "live"
      }
    }
  }
}
