{
  "name": "adripatina",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "adripatina — assistente de oficina de pintura e restauração de móveis (Telegram + painel + orçamentos)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "postinstall": "pnpm --filter @adripatina/admin-web run build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r run test",
    "build": "pnpm --filter @adripatina/admin-web run build && pnpm --filter @adripatina/worker run build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:migrate:local": "pnpm --filter @adripatina/worker run db:migrate:local",
    "db:seed:local": "pnpm --filter @adripatina/worker run db:seed:local",
    "dev": "pnpm --filter @adripatina/worker run dev",
    "dev:admin": "pnpm --filter @adripatina/admin-web run dev",
    "demo": "pnpm --filter @adripatina/worker run demo",
    "seed:generate": "pnpm --filter @adripatina/worker run seed:generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@types/node": "^22",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.33.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
